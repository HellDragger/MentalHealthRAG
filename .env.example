# Copy to .env and fill in what you need. Never commit .env.
# Every setting in configs/default.yaml can be overridden with MHRAG_<SECTION>__<KEY>.

# --- LLM backend selection ---
# One of: hf | llamacpp | ollama | openai_compatible | mock
# MHRAG_LLM__BACKEND=openai_compatible
# Model key from configs/models.yaml
# MHRAG_LLM__MODEL=llama-3.3-70b-groq

# --- API keys (only read from the environment) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# --- Retrieval ---
# MHRAG_RETRIEVAL__MODE=hybrid_rerank    # bm25 | dense | hybrid | hybrid_rerank
# MHRAG_INDEX__EMBEDDER=bge-small        # key from configs/default.yaml embedders

# --- Safety ---
# MHRAG_SAFETY__REGION=IN                # IN | US | UK | INTL

# --- Server ---
# MHRAG_SERVER__RATE_LIMIT=20/minute
# MHRAG_SERVER__LOG_CONTENT=false        # message content is NOT logged unless true
